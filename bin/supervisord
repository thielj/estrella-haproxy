#!/bin/bash

# Minimal supervisord replacement using shell scripts
# This provides basic process management functionality

PID_FILE="${_VAR_DIR}/supervisord.pid"
HAPROXY_OPTS=(-W -S "${HAPROXY_SOCKET}" "$@")

# Store PIDs of managed processes
PROCESS_PIDS=""
TERMINATING=0
HAPROXY_PID=""

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] supervisord: $1" | tee -a "$_LOG_DIR/supervisord.log"
}

# Function to start scripts
start_scripts() {
    PROCESS_PIDS=""
    if [ -d "${_ETC_DIR}/scripts.d" ]; then
        for script in "${_ETC_DIR}/scripts.d"/*.sh; do
            if [ -x "$script" ]; then
                script_name=$(basename "$script" .sh)
                log "Starting script: $script_name"
                "$script" > "$_LOG_DIR/${script_name}.log" 2> "$_LOG_DIR/${script_name}_error.log" &
                script_pid=$!
                PROCESS_PIDS="$PROCESS_PIDS $script_pid"
                log "Script $script_name started with PID $script_pid"
            fi
        done
    fi
}

# Function to stop all processes
stop_all() {
    log "Stopping all processes..."

    for pid in $PROCESS_PIDS; do
        if kill -0 "$pid" 2>/dev/null; then
            log "Stopping process $pid"
            kill -TERM "$pid" 2>/dev/null || true
        fi
    done

    # Wait for processes to stop
    sleep 5

    for pid in $PROCESS_PIDS; do
        if kill -0 "$pid" 2>/dev/null; then
            log "Force killing process $pid"
            kill -9 "$pid" 2>/dev/null || true
        fi
    done

    rm -f "$PID_FILE"
}

# Function to check and restart failed processes
check_processes() {
    for pid in $PROCESS_PIDS; do
        if kill -0 "$pid" 2>/dev/null; then
            # Process is running
            continue
        else
            log "Process $pid has died, restarting services..."
            # For simplicity, restart all services
            stop_all
            if [ "$TERMINATING" -eq 0 ]; then start_all; fi
            return
        fi
    done
}

termination_handler() {
    TERMINATING=1
    PROCESS_PIDS="$PROCESS_PIDS $HAPROXY_PID"
    stop_all
    exit 0
}

# shellcheck disable=SC2329
shutdown_handler() {
    log "USR1 or INT signal received"

    if [ -n "$HAPROXY_PID" ] && kill -0 "$HAPROXY_PID" 2>/dev/null; then
        log "Sending HAProxy graceful shutdown signal"
        kill -USR1 "$HAPROXY_PID" 2>/dev/null || true
    fi

    termination_handler
}

# Signal handlers
trap 'termination_handler' TERM
trap 'shutdown_handler' USR1 INT

log "Starting minimal supervisord..."
echo $$ > "$PID_FILE"

# Start scripts and check processes in the background
( sleep 10; start_scripts; while true; do
    sleep 10
    if [ "$TERMINATING" -eq 1 ]; then break; fi
    check_processes
done ) &

# Run HAProxy in foreground
log "Starting HAProxy in foreground..."
haproxy "${HAPROXY_OPTS[@]}" &
HAPROXY_PID=$!
log "HAProxy started with PID $HAPROXY_PID"

wait $HAPROXY_PID
HAPROXY_PID=""

log "HAProxy has exited, stopping all scripts..."
termination_handler